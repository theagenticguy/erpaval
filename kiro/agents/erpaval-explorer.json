{
  "name": "erpaval-explorer",
  "description": "Read-only codebase explorer. Build mental models, find files, trace symbols, summarize architecture. Cannot modify files.",
  "prompt": "file://./prompts/erpaval-explorer.md",
  "model": "claude-opus-4-7",
  "tools": [
    "fs_read",
    "grep",
    "glob",
    "execute_bash",
    "code",
    "introspect",
    "tool_search",
    "knowledge",
    "thinking",
    "todo",
    "session",
    "web_fetch",
    "web_search"
  ],
  "allowedTools": ["*"],
  "toolsSettings": {
    "shell": {
      "deniedCommands": [
        "rm *",
        "mv *",
        "git push *",
        "git commit *",
        "git reset --hard *"
      ]
    }
  },
  "includeMcpJson": false
}
